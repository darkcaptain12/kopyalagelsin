# ─────────────────────────────────────────────────────────────
# KOPYALA GELSİN — Ortam Değişkenleri
# Bu dosyayı kopyalayın: cp .env.example .env.local
# Gerçek değerleri .env.local içinde doldurun, asla commit etmeyin.
# ─────────────────────────────────────────────────────────────

# ── PayTR Ödeme Entegrasyonu ──────────────────────────────────
PAYTR_MERCHANT_ID=your_merchant_id
PAYTR_MERCHANT_KEY=your_merchant_key
PAYTR_MERCHANT_SALT=your_merchant_salt
# Test modu: 1 = aktif (gerçek ödeme alınmaz), 0 = production
PAYTR_TEST_MODE=1

# ── Admin Paneli ──────────────────────────────────────────────
ADMIN_PASSWORD=your_strong_admin_password

# ── Uygulama URL ─────────────────────────────────────────────
# Üretimde gerçek domain adresini yazın
NEXT_PUBLIC_APP_URL=https://kopyalagelsin.com

# ── JWT Session ───────────────────────────────────────────────
# openssl rand -hex 32  komutuyla güçlü bir secret üretin
JWT_SECRET=your_jwt_secret_here

# ── Vercel Blob Storage (Üretim) ─────────────────────────────
# Vercel Dashboard > Storage > Blob > Token
BLOB_READ_WRITE_TOKEN=your_vercel_blob_token

# ── E-posta Bildirimi (Gmail SMTP) ───────────────────────────
# Sadece başarılı ödemeler için admin bildirimi gönderilir.
# Gmail hesabında "Uygulama Şifresi" (App Password) oluşturun:
# Google Hesabım > Güvenlik > 2 Adımlı Doğrulama > Uygulama Şifreleri
SMTP_USER=your_gmail_address@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
